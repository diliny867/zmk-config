#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi> // Requires auto-layer module.
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>


#include "keys/58.h"
#include "keys/keys_base.h"
#include "keys/keys_ru.h"

//https://github.com/urob/zmk-helpers
#include "zmk-helpers/helper.h"

#include "include/settings.dtsi"
#include "include/mods.dtsi"
#include "include/morphs.dtsi"
#include "include/ru_morphs.dtsi"
//#include "include/auto_layers.dtsi"
#include "include/other.dtsi"
//#include "include/combos.dtsi"
//#include "include/dance.dtsi"
//#include "include/macros.dtsi"


//#define RUSSIAN_MODE

#ifdef RUSSIAN_MODE
# define LANG_MODE &to 5
#else
# define LANG_MODE &trans
#endif



/{
   combos { compatible = "zmk,combos"; };

   keymap {
      compatible = "zmk,keymap";

      default_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &kp ESC      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                               &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp EQUAL
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T                                &kp Y        &kp U        &kp I        &kp O        &kp P        &kp MINUS
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &kp LSHIFT   &kp A        &hml RALT S  &hml LCTRL D &hml LSHIFT F &kp G                               &kp H        &hmr RSHIFT J &hmr LCTRL K &hmr RALT L &kp SEMI     &kp RSHIFT
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp B        &kp LBKT     &kp RBKT   &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp SQT
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &kp LALT     &kp LGUI     &mo 1        &kp SPACE    &kp RET    &mo 2        &kp BSPC     &mt RALT SPACE
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

      lower_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &trans       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                               &trans       &trans       &trans       &trans       &trans       &kp GRAVE
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp BSLH     &kp N4       &kp N5       &kp N6       &kp DEL                              &excl_morph  &kp SQT      &kp ASTRK    &kp MINUS    &kp PRCNT    &kp PIPE
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp N0       &hml RALT N1 &hml LCTRL N2 &hml LSHIFT N3 &kp LBKT                          &at_morph    &lpar_morph  &rpar_morph  &kp UNDER    &kp HASH     &kp TILDE
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp SLASH    &kp N7       &kp N8       &kp N9       &kp RBKT     &trans       &trans     &equal_morph &lbrc_morph  &rbrc_morph  &kp PLUS     &slash_morph &kp DOLLAR
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans     &trans       &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

      raise_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &trans       &trans       &trans       &trans       &trans       &trans                               &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                               &trans       &kp RET      &kp UP       &kp BSPC     &kp DEL      &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp F6       &hml RALT F7 &hml LCTRL F8 &hml LSHIFT F9 &kp F10                           &kp LC(S)    &kp LEFT     &kp DOWN     &kp RIGHT    &kp SLASH    &trans
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &trans       &kp LS(LC(T)) &kp TAB     &kp F11      &kp F12      &trans       &trans     &kp KP_PLUS  &kp MINUS    &kp EQUAL    &kp LBKT     &kp RBKT     &trans   
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans       &trans     &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

#define K_EP ext_power

      meta_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                         &trans       &trans       &trans       &trans       &trans       &to 4
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &out OUT_BLE &out OUT_USB &trans       &kp C_VOL_UP &kp C_MUTE   &kp C_NEXT                           &trans       &kp LA(LSHFT) &trans      &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &trans       &trans       &kp C_VOL_DN &kp C_PLAY_PAUSE &kp C_PREV                       &trans       &kp CAPSLOCK &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &K_EP EP_OFF &K_EP EP_ON  &K_EP EP_TOG &trans       &trans       &trans       &trans     &trans       LANG_MODE    &trans       &studio_unlock &trans     &trans
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans     &trans       &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

      gaming_layer {
         bindings = <
////╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
//   &kp ESC      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                               &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &to 0
////├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
//   &kp GRAVE    &kp TAB      &kp Q        &kp W        &kp E        &kp R                                &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P
////├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
//   &kp SEMI     &kp LSHFT    &kp A        &kp S        &kp D        &kp F                                &kp G        &kp H        &kp J        &kp K        &kp UP       &kp L
////├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
//   &kp FSLH     &kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp LBKT     &kp RBKT   &kp B        &kp N        &kp M        &kp LEFT     &kp DOWN     &kp RIGHT
////╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
//                                          &kp LALT     &kp SPACE    &trans       &kp SPACE    &kp RET    &trans       &kp BSPC     &mo 0
////                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯

//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &kp ESC      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                               &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &to 0
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T                                &kp Y        &kp U        &kp I        &kp O        &kp P        &kp SEMI
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &kp LSHIFT   &kp A        &kp S        &kp D        &kp F        &kp G                               &kp H        &kp J         &kp K        &kp L        &kp UP       &kp FSLH
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp B        &kp LBKT     &kp RBKT   &kp N        &kp M        &kp COMMA    &kp LEFT     &kp DOWN     &kp RIGHT
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &kp LALT     &kp SPACE    &trans       &kp SPACE    &kp RET    &mo 2        &kp BSPC     &mt RALT SPACE
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };


#ifdef RUSSIAN_MODE
# include "russian_mode_layers.keymap"
#endif

        
   };

   conditional_layers {
      compatible = "zmk,conditional-layers";

      meta_layer_condition {
         if-layers = <1 2>;
         then-layer = <3>;
      };
      
#ifdef RUSSIAN_MODE
      ru_meta_layer_condition {
         if-layers = <6 7>;
         then-layer = <8>;
      };
#endif
   };
};
