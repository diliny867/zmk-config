#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 750 /*default: 600*/
#define ZMK_POINTING_DEFAULT_SCRL_VAL 17  /*default: 10*/
#include <dt-bindings/zmk/pointing.h>


#include "keys/58.h"
#include "keys/keys_base.h"
#include "keys/keys_ru.h"

//https://github.com/urob/zmk-helpers
#include "zmk-helpers/helper.h"
#include "zmk-helpers/unicode-chars/greek.dtsi"


#define DEFLT 0
#define LOWER 1
#define NUM   2
#define RAISE 3
#define FUNC  4
#define META  5
#define GAMNG 6
#define OH_DEFLT 7
#define OH_LOWER 8
#define OH_NUM   9
#define OH_NAV   10


#include "include/settings.dtsi"
#include "include/hold_tap.dtsi"
#include "include/morphs.dtsi"
//#include "include/ru_morphs.dtsi"
#include "include/auto_layers.dtsi"
#include "include/combos.dtsi"
#include "include/tap_dance.dtsi"
#include "include/leader.dtsi"
//#include "include/macros.dtsi"
#include "include/other.dtsi"

#define SMART_NUM    &smart_num    NUM 0
#define LWR_SN       &smart_num    LOWER 0
#define OH_SMART_NUM &oh_smart_num OH_NUM 0
#define OH_LWR_SN    &oh_smart_num OH_LOWER 0

#define LT_LGUI_FUNC &lt_lgui FUNC 0

#define LALCLS LA(LC(LSHFT))

/{
   keymap {
      compatible = "zmk,keymap";

      default_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &kp ESC      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                               &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp ESC
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T                                &kp Y        &kp U        &kp I        &kp O        &kp P        &kp MINUS
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &ht_tp LSHIFT ESC &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHIFT F &kp G                            &kp H        &hmr RSHIFT J &hmr LCTRL K &hmr RALT L &hmr LGUI SEMI &kp RSHIFT
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp B        &kp LBKT     &kp RBKT   &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp SQT
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &kp LALT     LT_LGUI_FUNC LWR_SN       &kp SPACE    &kp RET    &mo RAISE    &kp BSPC     &mt RALT TAB
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

      lower_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &trans       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                               &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &kp GRAVE
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp BSPC     &kp N4       &kp N5       &kp N6       &kp DEL                              &mh_excl     &kp SQT      &kp ASTRK    &kp MINUS    &kp PRCNT    &kp PIPE
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp N0       &hml LALT N1 &hml LCTRL N2 &hml LSHIFT N3 &leader                           &mh_at  &hmr_lpar RSHIFT 0 &hmr_rpar LCTRL 0 &hmr RALT UNDER &kp HASH &kp TILDE
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &tri_alttab  &kp N7       &kp N8       &kp N9       &kp RBKT     &trans       &trans     &mh_equal    &mh_lbrc     &mh_rbrc     &kp PLUS     &mh_slash    &kp DOLLAR
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans     &trans       &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };
      
      num_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &trans       &trans       &trans       &trans       &trans       &trans                               &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &trans       &kp N4       &kp N5       &kp N6       &trans                               &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp N0       &hml LALT N1 &hml LCTRL N2 &hml LSHIFT N3 &trans                            &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &trans       &kp N7       &kp N8       &kp N9       &trans       &trans       &trans     &trans       &trans       &trans       &trans       &trans       &trans
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans     &trans       &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

      raise_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &trans       &trans       &trans       &trans       &trans       &trans                               &kp SLCK     &kp INS      &kp KP_NLCK  &kp LG(LS(S)) &kp LG(PSCRN) &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                               &kp PG_UP    &kp HOME     &kp UP       &kp END      &kp DEL      &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp F6       &hml LALT F7 &hml LCTRL F8 &hml LSHIFT F9 &kp F10                           &kp PG_DN    &kp LEFT     &kp DOWN     &kp RIGHT    &kp BSPC     &trans
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp LS(LC(T)) &kp TAB     &tri_alttab  &kp F11      &kp F12      &trans       &trans     &sk LC(LALT) &sk LC(LSHFT) &sk LALCLS  &sk LA(LSHFT) &sk LCTRL   &sk LG(LSHFT)   
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans     &trans       &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

      function_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &trans       &trans       &trans       &trans       &trans       &trans                               &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp LG(LA(SPACE)) &kp LC(W) &kp LC(E)  &kp LC(R)    &kp LC(Y)                            &msc SCRL_UP &mkp LCLK    &mmv MOVE_UP &mkp RCLK    &kp LG(PSCRN) &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp LC(A)  &hml LALT LC(S) &hml LCTRL LC(D) &hml LSHIFT LC(F) &trans                     &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp LC(Z)    &kp LC(X)    &kp LC(C)    &kp LC(V)    &trans       &trans       &trans     &trans      &msc SCRL_LEFT &mkp MCLK &msc SCRL_RIGHT &tog FUNC   &trans   
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans       &trans     &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

#define K_EP ext_power

      meta_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                         &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &out OUT_BLE &out OUT_USB &trans       &kp C_VOL_UP &kp C_MUTE   &kp C_NEXT                           &trans       &kp LA(LSHFT) &trans      &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &trans       &trans       &kp C_VOL_DN &kp C_PLAY_PAUSE &kp C_PREV                       &trans       &kp CAPSLOCK &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &sys_reset   &K_EP EP_OFF &K_EP EP_ON  &K_EP EP_TOG &trans       &trans       &to DEFLT    &trans     &trans       &trans       &trans       &studio_unlock &trans     &sys_reset
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans     &trans       &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

      gaming_layer {
         bindings = <
////╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
//   &kp ESC      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                               &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &to 0
////├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
//   &kp GRAVE    &kp TAB      &kp Q        &kp W        &kp E        &kp R                                &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P
////├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
//   &kp SEMI     &kp LSHFT    &kp A        &kp S        &kp D        &kp F                                &kp G        &kp H        &kp J        &kp K        &kp UP       &kp L
////├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
//   &kp FSLH     &kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp LBKT     &kp RBKT   &kp B        &kp N        &kp M        &kp LEFT     &kp DOWN     &kp RIGHT
////╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
//                                          &kp LALT     &kp SPACE    &trans       &kp SPACE    &kp RET    &trans       &kp BSPC     &mo 0
////                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯

//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &kp ESC      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                               &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &to DEFLT
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T                                &kp Y        &kp U        &kp I        &kp O        &kp P        &kp SEMI
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &kp LSHIFT   &kp A        &kp S        &kp D        &kp F        &kp G                                &kp H        &kp J        &kp K        &kp L        &kp UP       &kp FSLH
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp B        &kp LBKT     &kp RBKT   &kp N        &kp M        &kp COMMA    &kp LEFT     &kp DOWN     &kp RIGHT
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &kp LALT     &kp SPACE    &mo LOWER    &kp SPACE    &kp RET    &mo RAISE    &kp BSPC     &mt RALT SPACE
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };


      onehand_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &kp ESC      &mh_ohn1     &mh_ohn2     &mh_ohn3     &mh_ohn4     &mh_ohn5                             &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &kp TAB      &ohkp Y Q    &ohkp U W    &ohkp I E    &ohkp O R    &ohkp P T                            &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &kp LSHIFT   &ohkp H A    &ohkp J S    &ohkp K D    &ohkp L F    &ohkp SEMI G                         &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &kp LCTRL    &ohkp N Z    &ohkp M X    &ohkp COMMA C &ohkp DOT V &ohkp FSLH B &ohkp RBKT LBKT &trans  &trans       &trans       &trans       &trans       &trans       &trans
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &mh_lalt     &lt OH_NAV LGUI OH_LWR_SN &mh_ohspace  &trans     &trans       &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

      onehand_lower_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &mh_grave    &ohkp F1 F6  &ohkp F2 F7  &ohkp F3 F8  &oh_td_f4    &oh_td_f5                            &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &mh_dollar   &mh_minus    &kp ASTRK    &kp SQT      &mh_excl                             &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &mh_hash     &kp UNDER    &mh_rpar     &mh_lpar     &mh_at                               &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &mh_slash    &mh_slash    &mh_rbrc     &mh_lbrc     &mh_equal    &trans       &trans     &trans       &trans       &trans       &trans       &trans       &trans
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans     &trans       &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

      onehand_num_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &trans       &trans       &trans       &trans       &trans       &trans                               &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &trans       &kp N4       &kp N5       &kp N6       &trans                               &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp N0       &kp N1       &kp N2       &kp N3       &trans                               &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &trans       &kp N7       &kp N8       &kp N9       &trans       &trans       &trans     &trans       &trans       &trans       &trans       &trans       &trans
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans     &trans       &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

      onehand_nav_layer {
         bindings = <
//╭------------┬------------┬------------┬------------┬------------┬------------┬----------╮ ╭----------┬------------┬------------┬------------┬------------┬------------┬------------╮
   &trans       &mh_lock     &kp LG(PSCRN) &kp LG(LS(S)) &kp INS    &kp CAPSLOCK                         &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp LG(LA(SPACE)) &kp END &kp UP       &kp HOME     &kp PG_UP                            &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┤          | |          ├------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp LC(LSHIFT) &kp LEFT   &kp DOWN     &kp RIGHT    &kp PG_DN                            &trans       &trans       &trans       &trans       &trans       &trans
//├------------┼------------┼------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┼------------┼------------┤
   &trans       &kp LALT     &trans       &kp DEL      &kp BSPC     &trans       &trans       &trans     &trans       &trans       &trans       &trans       &trans       &trans
//╰------------┴------------┴------------┼------------┼------------┼------------┼----------┤ ├----------┼------------┼------------┼------------┼------------┴------------┴------------╯
                                          &trans       &trans       &trans       &trans       &trans     &trans       &trans       &trans
//                                       ╰------------┴------------┴------------┴----------╯ ╰----------┴------------┴------------┴------------╯
         >;
      };

   };


   conditional_layers {
      compatible = "zmk,conditional-layers";

      meta_layer_condition {
         if-layers = <LOWER RAISE>;
         then-layer = <META>;
      };

      onehand_meta_layer_condition {
         if-layers = <OH_NAV OH_LOWER>;
         then-layer = <META>;
      };
   };

   
};