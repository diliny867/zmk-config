

ZMK_TAP_DANCE(oh_f4_td, 
    bindings = <&ohkp F9 F4>, <&ohkp_excl 0 F11>;
    tapping-term-ms = <200>;
)

ZMK_TAP_DANCE(oh_f5_td, 
    bindings = <&ohkp F10 F5>, <&ohkp_excl 0 F12>;
    tapping-term-ms = <200>;
)


#define ZMK_BEHAVIOR_CORE_tap_dance1     compatible = "zmk,behavior-tap-dance"; #binding-cells = <1>
ZMK_BEHAVIOR(td_kp1, tap_dance1, 
    bindings = <&kp>, <&kp>;
    tapping-term-ms = <200>;
)

