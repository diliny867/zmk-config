
ZMK_MOD_MORPH(lpar_bkt,
    bindings = <&kp LPAR>, <&kp LBKT>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

/ {
  behaviors {
    //lpar_bkt: morph_lpar_into_lbkt {
    //  compatible = "zmk,behavior-mod-morph";
    //  #binding-cells = <0>;
    //  bindings = <&kp LPAR>, <&kp LBKT>;
    //  mods = <(MOD_LSFT|MOD_RSFT)>;
    //};
    rpar_bkt: morph_rpar_into_rbkt {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp RPAR>, <&kp RBKT>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    lbrc_lt: morph_lbrc_into_lt {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp LBRC>, <&kp LT>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    rbrc_gt: morph_rbrc_into_gt {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp RBRC>, <&kp GT>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    comma_morph: comma_morph {
      compatible = "zmk,behavior-mod-morph";
      label = "COMMA_MORPH";
      #binding-cells = <0>;
      bindings = <&kp COMMA>, <&kp SEMI>;
      mods = <(MOD_RSFT)>;
    };
    dot_morph: dot_morph {
      compatible = "zmk,behavior-mod-morph";
      label = "DOT_MORPH";
      #binding-cells = <0>;
      bindings = <&kp DOT>, <&kp COLON>;
      mods = <(MOD_RSFT)>;
    };
    // quote_morph: quote_morph {
    //   compatible = "zmk,behavior-mod-morph";
    //   label = "QUOTE_MORPH";
    //   #binding-cells = <0>;
    //   bindings = <&kp DQT>, <&kp SQT>;
    //   mods = <(MOD_RSFT)>;
    // };
    qmark_morph: qmark_morph {
      compatible = "zmk,behavior-mod-morph";
      label = "QMARK_MORPH";
      #binding-cells = <0>;
      bindings = <&kp QMARK>, <&kp EXCL>;
      mods = <(MOD_RSFT|MOD_LSFT)>;
    };
  };
};
